{
    "resolution": [ 1024, 768 ],
    "fullscreen": true,
    "correct_game_aspect_ratio": false,
    "correct_menu_aspect_ratio": true,
    "hud_scale": 1.0,
    "max_anisotropy": 2.0,
    "antialiasing": {
        "type": "MSAA",
        "samples": 2
    },
    "enable_bloom": true,
    "enable_blur": true,
    "enable_trails": true,
    "enable_fog": true,
    "enable_post": true,
    "enable_hdr": false,
    "auto_exposure_sensitivity": 0.0,
    "hdr_exposure_compensation": 0.5,
    "hdr_shadow_softness": 0.6,
    "hdr_color_crispness": 0.0,
    "enable_reflections": true,
    "enable_dynamic_light_specular": false,
    "enable_ssao": true,
    "enable_parallax": true,
    "enable_texture_filtering": true,
    "retro_mode": false,
    "enable_posterized_lighting": false,
    "enable_vsync": false,
    "profile_renderer": false,
    "profile_audio": false,
    "profile_auto_exposure": false,
    "optimize_hud_uploads": true,
    "use_model_cache": false,
    "mesh_revision_tracking": false,
    "enable_spotlights": false,
    "enable_spotlight_shadows": false,
    "spotlight_shadow_resolution": 256,
    "enable_sun": true,
    "enable_sun_shadows": false,
    "sun_shadow_resolution": 512,
    "sun_shadow_instance_batches": false,
    "enable_decals": true,
    "enable_mesh_collision": false,
    "use_vanilla_renderer": false
}
