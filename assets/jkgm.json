{
    "resolution": [ 1024, 768 ],
    "fullscreen": true,
    "correct_game_aspect_ratio": false,
    "correct_menu_aspect_ratio": true,
    "hud_scale": 1.0,
    "max_anisotropy": 2.0,
    "antialiasing": {
        "type": "MSAA",
        "samples": 2
    },
    "enable_bloom": true,
    "enable_blur": true,
    "enable_trails": true,
    "enable_fog": true,
    "enable_post": true,
    "enable_hdr": false,
    "auto_exposure_sensitivity": 0.4,
    "hdr_exposure_compensation": 0.0,
    "hdr_shadow_softness": 0.3,
    "hdr_color_crispness": 0.6,
    "enable_reflections": true,
    "enable_default_specular": false,
    "default_specular_strength": 0.25,
    "default_specular_roughness": 0.85,
    "enable_dynamic_light_specular": false,
    "enable_baked_overbright": true,
    "experimental_volumetric_ambient": false,
    "experimental_continuous_ambient_cpu": false,
    "experimental_continuous_ambient_gpu": false,
    "experimental_world_vertex_ambient": false,
    "experimental_world_vertex_ambient_radius": 1.0,
    "gpu_pixel_lighting": false,
    "enable_ssao": true,
    "enable_parallax": true,
    "enable_texture_filtering": true,
    "retro_mode": false,
    "enable_posterized_lighting": false,
    "enable_vsync": false,
    "profile_renderer": false,
    "profile_audio": false,
    "use_gpu_cache": true,
    "enable_gpu_sprite_instancing": true,
    "enable_saber_trails": true,
    "saber_trail_delay": 0.06,
    "enable_gpu_camera_hud": true,
    "camera_hud_depth_sort": true,
    "enable_native_fallback": true,
    "enable_gpu_mat_warmup": true,
    "enable_spotlights": false,
    "enable_spotlight_shadows": false,
    "spotlight_shadow_resolution": 256,
    "spotlight_shadow_angle_bias_scale": 0.0,
    "enable_sun": true,
    "enable_sun_shadows": false,
    "sun_shadow_update_interval": 0.0,
    "sun_shadow_resolution": 512,
    "enable_decals": true,
    "enable_mesh_collision": false,
    "use_vanilla_renderer": false
}
